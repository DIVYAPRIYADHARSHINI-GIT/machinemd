# MachineMD environment variables. All are OPTIONAL - the app runs with safe defaults.
# Copy to .env (never commit .env) or set them in the Vercel project settings.

# Secret used to sign JWT access tokens. Set a long random value in production.
# If unset, a built-in demo secret is used and /api/health reports jwt_secret_configured=false.
MACHINEMD_JWT_SECRET=

# Access-token lifetime in minutes (default 480 = 8 hours).
MACHINEMD_JWT_EXPIRE_MINUTES=480

# Writable runtime directory for the working copy of the database and retrained models.
# Default: <system temp>/machinemd (on Vercel: /tmp/machinemd, the only writable path).
MACHINEMD_DATA_DIR=

# Comma-separated origins allowed by CORS. Not needed when frontend and API share one origin
# (the Vercel deployment and the Vite dev proxy). Default: http://localhost:5173,http://127.0.0.1:5173
MACHINEMD_CORS_ORIGINS=

# Frontend dev only: where the Vite dev server proxies /api (default http://127.0.0.1:8000).
VITE_API_PROXY=
